# A push of code to the default branch runs the tests, builds an image tagged with the commit,
# asks the target to deploy that tag and waits until it is healthy.
# Secrets the repository needs: <TARGET_TOKEN> and <TARGET_APP>. Fill every <placeholder> and remove this line.
name: deploy

on:
  push:
    branches: [<default branch>]
    # A change of documentation alone does not rebuild the image or redeploy.
    paths-ignore:
      - "docs/**"
      - "README.md"
      - "ARCHITECTURE.md"
  workflow_dispatch:

env:
  IMAGE: ghcr.io/<owner>/<image name>
  TARGET_URL: <address of the deployment target>

# One deployment at a time; a queued one is not cancelled.
concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: false

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: <setup action for the runtime>
        with:
          <version input of that action>: <runtime version>
      - run: <command that installs the dependencies>
      - run: <command that runs the tests>

  build-deploy:
    needs: test
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    env:
      # Without the target's secrets the image is still built and the deployment is skipped.
      HAS_TARGET: ${{ secrets.<TARGET_TOKEN> != '' && secrets.<TARGET_APP> != '' }}
    steps:
      - uses: actions/checkout@v4

      - uses: docker/setup-buildx-action@v3

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - uses: docker/build-push-action@v6
        with:
          context: .
          push: true
          platforms: linux/amd64
          tags: |
            ${{ env.IMAGE }}:${{ github.sha }}
            ${{ env.IMAGE }}:latest
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # Coolify variant: point the application at the new tag, then ask for the deployment.
      # For another target, keep the two steps and replace their calls.
      - name: Redeploy with the immutable tag
        if: env.HAS_TARGET == 'true'
        env:
          TARGET_TOKEN: ${{ secrets.<TARGET_TOKEN> }}
          APP_ID: ${{ secrets.<TARGET_APP> }}
        run: |
          curl -fsS -X PATCH "$TARGET_URL/api/v1/applications/$APP_ID" \
            -H "Authorization: Bearer $TARGET_TOKEN" \
            -H "Content-Type: application/json" \
            -d '{"docker_registry_image_tag": "${{ github.sha }}"}'
          curl -fsS -X POST "$TARGET_URL/api/v1/deploy" \
            -H "Authorization: Bearer $TARGET_TOKEN" \
            -H "Content-Type: application/json" \
            -d "{\"uuid\": \"$APP_ID\"}"

      - name: Verify health
        if: env.HAS_TARGET == 'true'
        env:
          TARGET_TOKEN: ${{ secrets.<TARGET_TOKEN> }}
          APP_ID: ${{ secrets.<TARGET_APP> }}
        run: |
          for attempt in $(seq 1 30); do
            status=$(curl -fsS "$TARGET_URL/api/v1/applications/$APP_ID" \
              -H "Authorization: Bearer $TARGET_TOKEN" | jq -r '.status // empty')
            echo "attempt $attempt: status=$status"
            case "$status" in running:healthy*) exit 0 ;; esac
            sleep 10
          done
          echo "the application did not become healthy" >&2
          exit 1
